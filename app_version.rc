// Shared VERSIONINFO resource for all build outputs:
//   nvngx_dlssnr.dll / dlssnr_console.exe / DLSS5NR-CostScaler-Manager.exe
// Keep FILEVERSION / ProductVersion / "FileVersion" / "ProductVersion"
// in sync with the VERSION variable in build.bat.
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,6,3,0
 PRODUCTVERSION 0,6,3,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L   // VOS_NT_WINDOWS32
 FILETYPE       0x1L       // VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",    "DLSS5NR-CostScaler Project"
            VALUE "FileDescription","DLSS5NR-CostScaler 0.6.3"
            VALUE "FileVersion",    "0.6.3"
            VALUE "InternalName",   "dlssnr"
            VALUE "LegalCopyright", "MIT License"
            VALUE "ProductName",    "DLSS5NR-CostScaler"
            VALUE "ProductVersion", "0.6.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
